{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TsaoDFT Benchmark Evidence Result",
  "type": "object",
  "required": [
    "benchmark_plan_id",
    "candidate_id",
    "engine",
    "input_sha256",
    "method_fingerprint_id",
    "wall_time_seconds",
    "parser_acceptance",
    "exit_status"
  ],
  "properties": {
    "benchmark_plan_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "engine": {"type": "string"},
    "engine_version": {"type": "string"},
    "build_fingerprint": {"type": "string"},
    "compiler": {"type": "string"},
    "mpi": {"type": "object"},
    "openmp_runtime": {"type": "string"},
    "accelerator_runtime": {"type": "object"},
    "hardware": {"type": "object"},
    "binding": {"type": "object"},
    "scheduler": {"type": "object"},
    "filesystem": {"type": "object"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "method_fingerprint_id": {"type": "string"},
    "convergence": {"type": "object"},
    "output_artifact_sha256": {"type": "string"},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "cpu_time_seconds": {"type": "number", "minimum": 0},
    "scf_iterations": {"type": "integer", "minimum": 0},
    "peak_host_memory_bytes": {"type": "integer", "minimum": 0},
    "peak_device_memory_bytes": {"type": "integer", "minimum": 0},
    "utilization": {"type": "object"},
    "scientific_results": {"type": "object"},
    "parser_acceptance": {"enum": ["PASS", "FAIL", "NOT_AVAILABLE"]},
    "exit_status": {"type": "integer"},
    "timestamp": {"type": "string"},
    "repeat_index": {"type": "integer", "minimum": 1},
    "evidence_source": {"type": "string"},
    "missing_fields": {"type": "array", "items": {"type": "string"}}
  }
}
